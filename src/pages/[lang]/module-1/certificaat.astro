---
import ModuleLayout from '../../../layouts/ModuleLayout.astro';
import { t, supportedLangs, type Lang } from '../../../i18n/index';

export function getStaticPaths() {
  return supportedLangs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const i18n = t(lang);
const cert = i18n.certificate;
---

<ModuleLayout
  title={cert.title}
  lang={lang}
  currentPath={Astro.url.pathname}
>
  <div class="py-6">
    <p class="text-xs font-semibold uppercase tracking-wide mb-3" style="color: var(--turquoise);">Module 1 afgerond</p>
    <h1 class="text-2xl font-extrabold mb-2" style="color: var(--navy);">{cert.title}</h1>
    <p class="text-gray-500 mb-8">{cert.text}</p>

    <!-- Certificaat preview -->
    <div class="bg-white rounded-2xl border-2 p-8 mb-6 text-center" style="border-color: var(--mango);">
      <div class="w-12 h-12 rounded-full mx-auto mb-4 flex items-center justify-center" style="background-color: var(--mango);">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
        </svg>
      </div>
      <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1">AI Kompas · Module 1</p>
      <p class="text-lg font-extrabold mb-6" style="color: var(--navy);">Slim werken met AI</p>
      <label class="block text-xs font-semibold text-gray-400 mb-2 uppercase tracking-wide">{cert.name_label}</label>
      <input
        id="cert-name"
        type="text"
        class="w-full border-b-2 border-gray-200 focus:border-current bg-transparent px-2 py-2 text-center text-base font-bold focus:outline-none"
        style="color: var(--navy);"
        placeholder="Jouw naam"
      />
    </div>

    <button
      id="download-btn"
      class="w-full text-white font-bold text-base py-4 rounded-xl transition-opacity hover:opacity-90 active:scale-[0.99] mb-4"
      style="background-color: var(--mango);"
    >
      {cert.download}
    </button>

    <a
      href={`/${lang}/`}
      class="block text-center text-sm font-medium text-gray-400 hover:text-gray-600 py-2"
    >
      ← Terug naar overzicht
    </a>
  </div>
</ModuleLayout>

<script>
  document.getElementById('download-btn')?.addEventListener('click', () => {
    const name = (document.getElementById('cert-name') as HTMLInputElement).value || 'Leerling';
    const lines = [
      '════════════════════════════════',
      '           AI KOMPAS',
      '════════════════════════════════',
      '',
      '  Module 1 – Slim werken met AI',
      '',
      `  Behaald door: ${name}`,
      `  Datum: ${new Date().toLocaleDateString('nl-NL')}`,
      '',
      '════════════════════════════════',
    ];
    const blob = new Blob([lines.join('\n')], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `AI-Kompas-certificaat-${name}.txt`;
    a.click();
    URL.revokeObjectURL(url);
  });
</script>
