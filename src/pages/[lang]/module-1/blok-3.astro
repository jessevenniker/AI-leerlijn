---
import ModuleLayout from '../../../layouts/ModuleLayout.astro';
import QuizBlock from '../../../components/QuizBlock.astro';
import { t, supportedLangs, type Lang } from '../../../i18n/index';

export function getStaticPaths() {
  return supportedLangs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const i18n = t(lang);
const blok = i18n.module1.blocks.blok3;
---

<ModuleLayout
  title={blok.title}
  currentBlock={3}
  totalBlocks={4}
  lang={lang}
  currentPath={Astro.url.pathname}
>
  <div class="mb-6">
    <p class="text-xs font-semibold uppercase tracking-wide mb-2" style="color: var(--turquoise);">Blok 03</p>
    <h1 class="text-2xl font-extrabold leading-snug mb-3" style="color: var(--navy);">{blok.title}</h1>
    <p class="text-gray-500 text-base leading-relaxed">{blok.intro}</p>
  </div>

  <!-- AI-fout voorbeeld -->
  <div class="rounded-2xl border border-gray-200 bg-white p-5 mb-4">
    <p class="text-xs font-semibold uppercase tracking-wide mb-3 text-gray-400">AI antwoordde dit:</p>
    <p class="text-base text-gray-700 italic leading-relaxed">
      "De hoofdstad van Australië is Sydney."
    </p>
    <div class="mt-3 pt-3 border-t border-gray-100">
      <p class="text-xs text-gray-400">Denk na voor je klikt. Klopt dit?</p>
    </div>
  </div>

  <img
    src="/images/blok3/kind-checkt.png"
    alt="Kind vergelijkt AI-antwoord kritisch met een boek"
    class="rounded-2xl w-full object-cover mb-6"
    style="max-height: 220px;"
  />

  <QuizBlock
    question={blok.quiz.question}
    options={blok.quiz.options}
    correctIndex={1}
    feedbackCorrect={blok.quiz.feedback_correct}
    feedbackWrong={blok.quiz.feedback_wrong}
  />

  <a
    href={`/${lang}/module-1/blok-4/`}
    class="block w-full text-center text-white font-bold text-base py-4 rounded-xl transition-opacity hover:opacity-90 active:scale-[0.99] mt-4"
    style="background-color: var(--navy);"
  >
    Volgende blok →
  </a>
</ModuleLayout>
