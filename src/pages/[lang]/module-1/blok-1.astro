---
import ModuleLayout from '../../../layouts/ModuleLayout.astro';
import QuizBlock from '../../../components/QuizBlock.astro';
import { t, supportedLangs, type Lang } from '../../../i18n/index';

export function getStaticPaths() {
  return supportedLangs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const i18n = t(lang);
const blok = i18n.module1.blocks.blok1;
---

<ModuleLayout
  title={blok.title}
  currentBlock={1}
  totalBlocks={4}
  lang={lang}
  currentPath={Astro.url.pathname}
>
  <div class="mb-6">
    <p class="text-xs font-semibold uppercase tracking-wide mb-2" style="color: var(--turquoise);">Blok 01</p>
    <h1 class="text-2xl font-extrabold leading-snug mb-3" style="color: var(--navy);">{blok.title}</h1>
    <p class="text-gray-500 text-base leading-relaxed">{blok.intro}</p>
  </div>

  <img
    src="/images/blok1/ai-hond.png"
    alt="Kind op Curaçao dat AI-herkenning op een tablet ziet"
    class="rounded-2xl w-full object-cover mb-6"
    style="max-height: 220px;"
  />

  <!-- Uitlegkaart -->
  <div class="bg-white rounded-2xl border border-gray-200 p-5 mb-6">
    <p class="text-xs font-semibold uppercase tracking-wide mb-3" style="color: var(--navy);">Wat is AI?</p>
    <p class="text-sm text-gray-600 leading-relaxed">
      AI is een systeem dat heel veel voorbeelden heeft gezien en daar patronen in herkent.
      Het herkent een hond omdat het miljoenen foto's van honden heeft bekeken.
      Maar het <em>begrijpt</em> niet wat een hond is — het herkent het patroon alleen.
    </p>
  </div>

  <QuizBlock
    question={blok.quiz.question}
    options={blok.quiz.options}
    correctIndex={1}
    feedbackCorrect={blok.quiz.feedback_correct}
    feedbackWrong={blok.quiz.feedback_wrong}
  />

  <a
    href={`/${lang}/module-1/blok-2/`}
    class="block w-full text-center text-white font-bold text-base py-4 rounded-xl transition-opacity hover:opacity-90 active:scale-[0.99] mt-4"
    style="background-color: var(--navy);"
  >
    Volgende blok →
  </a>
</ModuleLayout>
