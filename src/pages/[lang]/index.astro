---
import ModuleLayout from '../../layouts/ModuleLayout.astro';
import { t, supportedLangs, type Lang } from '../../i18n/index';

export function getStaticPaths() {
  return supportedLangs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const i18n = t(lang);

const levels = [
  { num: 1, range: '8–10', label: 'AI begrijpen', color: 'var(--mango)', bg: 'var(--cream-bg)' },
  { num: 2, range: '10–13', label: 'AI verantwoord gebruiken', color: 'var(--turquoise)', bg: 'var(--mint-bg)', active: true },
  { num: 3, range: '13–16', label: 'AI maken en beoordelen', color: 'var(--coral)', bg: '#FEF0EA' },
];
---

<ModuleLayout title={i18n.site.title} lang={lang} currentPath={Astro.url.pathname}>

  <!-- Hero -->
  <div class="pt-4 pb-10">
    <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--turquoise);">
      Interactieve AI-leerlijn voor scholen
    </p>
    <h1 class="text-3xl font-extrabold leading-tight mb-4" style="color: var(--navy);">
      AI leren gebruiken<br/>met gezond verstand.
    </h1>
    <p class="text-gray-500 text-base leading-relaxed max-w-sm">
      {i18n.site.tagline}
    </p>
  </div>

  <!-- Niveau-kaarten -->
  <div class="space-y-3 mb-8">
    {levels.map((lvl) => (
      <div
        class={`rounded-2xl p-5 flex items-center gap-4 ${lvl.active ? 'border-2' : 'border border-gray-100'}`}
        style={`background-color: ${lvl.bg}; ${lvl.active ? `border-color: ${lvl.color};` : ''}`}
      >
        <div
          class="w-10 h-10 rounded-xl flex items-center justify-center text-white font-bold text-sm shrink-0"
          style={`background-color: ${lvl.color};`}
        >
          {lvl.num}
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-xs text-gray-400 mb-0.5">{lvl.range} jaar</p>
          <p class="font-semibold text-sm" style={`color: var(--navy);`}>{lvl.label}</p>
        </div>
        {lvl.active
          ? <span class="text-xs font-semibold px-2 py-1 rounded-full text-white shrink-0" style={`background-color: ${lvl.color};`}>Beschikbaar</span>
          : <span class="text-xs text-gray-300 shrink-0">Binnenkort</span>
        }
      </div>
    ))}
  </div>

  <!-- Module 1 kaart -->
  <div class="bg-white rounded-2xl border border-gray-200 p-6 mb-6">
    <p class="text-xs font-semibold uppercase tracking-wide mb-1" style="color: var(--turquoise);">Module 1 · Niveau 2</p>
    <h2 class="text-lg font-bold mb-1" style="color: var(--navy);">{i18n.module1.title}</h2>
    <p class="text-sm text-gray-400 mb-5">{i18n.module1.duration} · {i18n.module1.level}</p>

    <div class="grid grid-cols-2 gap-2 mb-6">
      {Object.entries(i18n.module1.blocks).map(([key, block], i) => (
        <div class="rounded-xl p-3.5" style="background-color: var(--sand);">
          <p class="text-xs font-semibold text-gray-400 mb-1">Blok {i + 1}</p>
          <p class="text-sm font-semibold" style="color: var(--navy);">{block.title}</p>
        </div>
      ))}
    </div>

    <a
      href={`/${lang}/module-1/`}
      class="block w-full text-center text-white font-bold text-base py-4 rounded-xl transition-opacity hover:opacity-90 active:scale-[0.99]"
      style="background-color: var(--navy);"
    >
      {i18n.module1.start} →
    </a>
  </div>

  <!-- Voor scholen -->
  <div class="rounded-2xl border border-gray-200 p-5">
    <p class="text-xs font-semibold uppercase tracking-wide mb-3" style="color: var(--coral);">Voor scholen</p>
    <div class="space-y-2 text-sm text-gray-600">
      <p>✓ Inclusief leerkrachtgids en leerdoelen</p>
      <p>✓ Beschikbaar in Nederlands, Engels en Papiamentu</p>
      <p>✓ Pilotlicentie beschikbaar voor 2–3 klassen</p>
    </div>
  </div>

</ModuleLayout>
