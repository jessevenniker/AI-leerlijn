---
interface Props {
  question: string;
  options: string[];
  correctIndex: number;
  feedbacks?: string[];       // Per-antwoord uitleg (optioneel, anders fallback)
  feedbackCorrect: string;    // Fallback als feedbacks ontbreekt
  feedbackWrong: string;      // Fallback als feedbacks ontbreekt
  imageSrc?: string;
}

const { question, options, correctIndex, feedbacks, feedbackCorrect, feedbackWrong, imageSrc } = Astro.props;
const id = Math.random().toString(36).slice(2, 8);

// Bouw feedbacks array: gebruik per-antwoord tekst als aanwezig, anders fallback
const resolvedFeedbacks = options.map((_, i) =>
  feedbacks?.[i] ?? (i === correctIndex ? feedbackCorrect : feedbackWrong)
);
---

<div class="rounded-2xl border border-gray-200 bg-white p-6 my-6" id={`quiz-${id}`}>
  {imageSrc && (
    <img src={imageSrc} alt="" class="w-full rounded-xl mb-5 object-cover max-h-48" />
  )}
  <p class="font-bold text-base mb-4" style="color: var(--navy);">{question}</p>
  <div class="flex flex-col gap-2.5">
    {options.map((option, i) => (
      <button
        class="quiz-option w-full text-left px-5 py-3.5 rounded-xl border-2 border-gray-200 font-medium text-sm text-gray-700 transition-all hover:border-gray-300 hover:bg-gray-50 active:scale-[0.99]"
        data-index={i}
        data-correct={correctIndex}
        data-feedback={resolvedFeedbacks[i]}
        data-is-correct={i === correctIndex ? 'true' : 'false'}
        data-quiz={id}
      >
        {option}
      </button>
    ))}
  </div>

  <!-- Feedbackvak: toont na antwoord de uitleg + correct/fout label -->
  <div class="feedback-block mt-4 hidden rounded-xl p-4" id={`feedback-${id}`}>
    <p class="feedback-label text-xs font-bold uppercase tracking-wide mb-1" id={`label-${id}`}></p>
    <p class="feedback-text text-sm leading-relaxed" id={`text-${id}`}></p>
  </div>
</div>

<script>
  document.querySelectorAll('.quiz-option').forEach((btn) => {
    btn.addEventListener('click', function (this: HTMLButtonElement) {
      const quizId = this.dataset.quiz!;
      const isCorrect = this.dataset.isCorrect === 'true';
      const feedbackText = this.dataset.feedback!;

      const feedbackBlock = document.getElementById(`feedback-${quizId}`)!;
      const feedbackLabel = document.getElementById(`label-${quizId}`)!;
      const feedbackTextEl = document.getElementById(`text-${quizId}`)!;

      // Disable alle opties
      document.querySelectorAll(`[data-quiz="${quizId}"]`).forEach((b) => {
        (b as HTMLButtonElement).disabled = true;
        (b as HTMLElement).classList.add('opacity-50');
      });

      // Markeer gekozen antwoord
      this.classList.remove('opacity-50');
      if (isCorrect) {
        this.style.borderColor = '#2BB5B8';
        this.style.backgroundColor = '#E8F7F7';
      } else {
        this.style.borderColor = '#E8714A';
        this.style.backgroundColor = '#FEF0EA';
      }

      // Toon feedbackvak
      feedbackBlock.classList.remove('hidden');
      if (isCorrect) {
        feedbackBlock.style.backgroundColor = '#E8F7F7';
        feedbackBlock.style.borderLeft = '3px solid #2BB5B8';
        feedbackLabel.textContent = '✓ Correct';
        feedbackLabel.style.color = '#2BB5B8';
      } else {
        feedbackBlock.style.backgroundColor = '#FEF0EA';
        feedbackBlock.style.borderLeft = '3px solid #E8714A';
        feedbackLabel.textContent = '✗ Niet helemaal';
        feedbackLabel.style.color = '#E8714A';
      }
      feedbackTextEl.textContent = feedbackText;
      feedbackTextEl.style.color = '#1C3A4A';
    });
  });
</script>
